#!/usr/bin/env python3
from pathlib import Path
import shutil
import sys
from datetime import datetime

path = Path("apps/api/src/modules/dashboard.routes.ts")
if not path.exists():
    sys.exit(f"ERREUR: fichier introuvable: {path}")

text = path.read_text(encoding="utf-8")

start_marker = "          // Courbe d'accueil : résultat réalisé cumulé observé dans chaque situation"
end_marker = "          };\n        }\n        states.budget = severity(e.signals.filter((x: any) => x.domain === 'Budget'));"

start = text.find(start_marker)
if start < 0:
    sys.exit("ERREUR: début du bloc de trajectoire actuel introuvable. Aucun fichier modifié.")
if text.find(start_marker, start + 1) >= 0:
    sys.exit("ERREUR: plusieurs blocs de trajectoire trouvés. Aucun fichier modifié.")

end = text.find(end_marker, start)
if end < 0:
    sys.exit("ERREUR: fin du bloc de trajectoire actuel introuvable. Aucun fichier modifié.")

# Conserver la fermeture du if (expenses.budget || revenues.budget) et states.budget.
end += len("          };\n")

replacement = r"""          // Trajectoire DEP :
          // - CLCA porte la chronologie mensuelle ;
          // - YCONSDEP est la photographie budgétaire à date ;
          // - le dernier point est raccordé au réalisé YCONSDEP.
          const depSnapshot = (
            await pool.query(
              `select id,snapshot_date,exercise
               from financial_snapshots
               where upper(opale_entity)=upper($1)
                 and source_type='YCONSDEP'
               order by coalesce(exercise,extract(year from snapshot_date)::int) desc,
                        snapshot_date desc,created_at desc
               limit 1`,
              [e.opaleEntity || e.sources.budget.source_key]
            )
          ).rows[0] || null;

          if (depSnapshot) {
            const depExecution = (
              await pool.query(
                `select coalesce(sum(budget),0) budget,
                        coalesce(sum(committed),0) committed,
                        coalesce(sum(accounted),0) accounted
                 from financial_execution_lines
                 where snapshot_id=$1`,
                [depSnapshot.id]
              )
            ).rows[0];

            const rawDate = depSnapshot.snapshot_date;
            const snapshotDate =
              rawDate instanceof Date
                ? rawDate.toISOString().slice(0, 10)
                : /^\d{4}-\d{2}-\d{2}/.test(String(rawDate ?? ''))
                  ? String(rawDate).slice(0, 10)
                  : (() => {
                      const parsed = new Date(String(rawDate ?? ''));
                      return Number.isNaN(parsed.getTime()) ? null : parsed.toISOString().slice(0, 10);
                    })();
            if (!snapshotDate) throw new Error('Date YCONSDEP invalide');

            const snapshotYear =
              Number(depSnapshot.exercise) || Number(snapshotDate.slice(0, 4));
            const depBudget = Math.abs(Number(depExecution.budget || 0));
            const depCommitted = Math.abs(Number(depExecution.committed || 0));
            const depAccounted = Math.abs(Number(depExecution.accounted || 0));

            const clcaKeys = [
              e.opaleEntity,
              e.uai,
              e.name,
              e.sources.purchases?.establishment_name
            ]
              .filter(Boolean)
              .map((value: any) => String(value).trim().toUpperCase());

            const clcaRows = clcaKeys.length
              ? (
                  await pool.query(
                    `select extract(year from pl.order_date)::int exercise,
                            extract(month from pl.order_date)::int month,
                            coalesce(sum(case
                              when coalesce(pl.invoice_amount,0)>=0
                                then abs(coalesce(pl.invoice_amount,0))
                              else 0
                            end),0) expenses
                     from purchase_lines pl
                     join purchase_snapshots ps on ps.id=pl.snapshot_id
                     where pl.order_date is not null
                       and (
                         upper(coalesce(pl.establishment,''))=any($1::text[])
                         or upper(coalesce(ps.establishment_name,''))=any($1::text[])
                       )
                       and extract(year from pl.order_date) between $2 and $3
                     group by 1,2
                     order by 1,2`,
                    [clcaKeys, snapshotYear - 1, snapshotYear]
                  )
                ).rows
              : [];

            const cumulativeClca = (exercise: number) => {
              let total = 0;
              return clcaRows
                .filter((row: any) => Number(row.exercise) === exercise)
                .sort((a: any, b: any) => Number(a.month) - Number(b.month))
                .map((row: any) => {
                  total += Number(row.expenses || 0);
                  const month = Number(row.month);
                  const date = `${exercise}-${String(month).padStart(2, '0')}-${String(
                    new Date(exercise, month, 0).getDate()
                  ).padStart(2, '0')}`;
                  return { date, month, value: total };
                });
            };

            const actual = cumulativeClca(snapshotYear).filter(
              (point) => point.date <= snapshotDate
            );
            const previous = cumulativeClca(snapshotYear - 1);

            // Le point courant représente la photographie YCONSDEP.
            const snapshotMonth = new Date(`${snapshotDate}T12:00:00`).getMonth() + 1;
            const currentPoint = {
              date: snapshotDate,
              month: snapshotMonth,
              value: depAccounted
            };
            const currentMonthIndex = actual.findIndex(
              (point) => point.month === snapshotMonth
            );
            if (currentMonthIndex >= 0) actual[currentMonthIndex] = currentPoint;
            else actual.push(currentPoint);
            actual.sort((a, b) => a.month - b.month);

            const trajectoryTarget = Math.max(
              0.15,
              Math.min(0.98, budgetTrajectoryTarget(snapshotDate))
            );
            const known = Math.max(depAccounted, depCommitted);
            const pace = depAccounted / trajectoryTarget;
            const central = Math.min(
              depBudget || Number.POSITIVE_INFINITY,
              Math.max(known, pace)
            );
            const uncertainty = Math.max(0, central - depAccounted) * 0.18;
            const depForecast = {
              low: Math.max(known, central - uncertainty),
              central,
              high: central + uncertainty
            };

            const budgetReference = Array.from({ length: 12 }, (_, index) => {
              const month = index + 1;
              const date = `${snapshotYear}-${String(month).padStart(2, '0')}-${String(
                new Date(snapshotYear, month, 0).getDate()
              ).padStart(2, '0')}`;
              return {
                date,
                month,
                value: depBudget * budgetTrajectoryTarget(date)
              };
            });

            e.financialTrajectory = {
              mode: 'DEP',
              source: 'CLCA+YCONSDEP',
              exercise: snapshotYear,
              snapshotDate,
              actual,
              previous: previous.length
                ? { [String(snapshotYear - 1)]: previous }
                : {},
              budgetReference,
              forecast: depForecast,
              annualBudgetResult: depBudget
            };
          }
"""

backup = path.with_name(
    f"{path.name}.bak-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
)
shutil.copy2(path, backup)

updated = text[:start] + replacement + text[end:]
path.write_text(updated, encoding="utf-8")

print(f"OK: bloc remplacé dans {path}")
print(f"Sauvegarde: {backup}")
print("Vérification: grep -n \"Trajectoire DEP\" apps/api/src/modules/dashboard.routes.ts")
