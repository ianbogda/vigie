diff --git a/apps/api/src/modules/dashboard.routes.ts b/apps/api/src/modules/dashboard.routes.ts
--- a/apps/api/src/modules/dashboard.routes.ts
+++ b/apps/api/src/modules/dashboard.routes.ts
@@ -393,2 +393,130 @@
+        }
+
+        // Trajectoire DEP : YCONSDEP est la source fonctionnelle prioritaire.
+        // Si l'historique YCONSDEP de l'exercice ne contient qu'une situation,
+        // les écritures de classe 6 reconstituent uniquement la chronologie passée.
+        const depHistory = (
+          await pool.query(
+            `select fs.id,
+                    fs.snapshot_date,
+                    coalesce(fs.exercise, extract(year from fs.snapshot_date)::int) exercise,
+                    coalesce(sum(fel.budget),0) budget,
+                    coalesce(sum(fel.committed),0) committed,
+                    coalesce(sum(fel.accounted),0) accounted
+             from financial_snapshots fs
+             join financial_execution_lines fel on fel.snapshot_id=fs.id
+             where upper(fs.opale_entity)=upper($1)
+               and fs.source_type='YCONSDEP'
+             group by fs.id,fs.snapshot_date,fs.exercise
+             order by exercise,fs.snapshot_date,fs.id`,
+            [e.opaleEntity || e.sources.budget.source_key]
+          )
+        ).rows.map((row: any) => ({
+          date: row.snapshot_date instanceof Date ? row.snapshot_date.toISOString().slice(0, 10) : String(row.snapshot_date).slice(0, 10),
+          exercise: Number(row.exercise),
+          budget: Number(row.budget || 0),
+          committed: Number(row.committed || 0),
+          accounted: Math.abs(Number(row.accounted || 0))
+        }));
+
+        if (depHistory.length) {
+          const trajectoryExercise = Math.max(...depHistory.map((row: any) => row.exercise));
+          const monthlyLatest = (exercise: number) => {
+            const months = new Map<number, { date: string; month: number; value: number }>();
+            for (const row of depHistory.filter((item: any) => item.exercise === exercise)) {
+              const date = new Date(`${row.date}T12:00:00`);
+              if (Number.isNaN(date.getTime())) continue;
+              const month = date.getMonth() + 1;
+              const previous = months.get(month);
+              if (!previous || row.date > previous.date) months.set(month, { date: row.date, month, value: row.accounted });
+            }
+            return [...months.values()].sort((a, b) => a.month - b.month);
+          };
+
+          let actual = monthlyLatest(trajectoryExercise);
+          let actualSource: 'YCONSDEP' | 'ACCOUNTING_LINES' = 'YCONSDEP';
+
+          if (actual.length < 2) {
+            const accountingRows = (
+              await pool.query(
+                `select date_trunc('month',period_date)::date month_date,
+                        coalesce(sum(movement),0) movement
+                 from accounting_lines
+                 where upper(opale_entity)=upper($1)
+                   and extract(year from period_date)=$2
+                   and account ~ '^6'
+                   and coalesce(movement_kind,'') <> 'OPENING'
+                 group by date_trunc('month',period_date)
+                 order by month_date`,
+                [e.opaleEntity || e.sources.budget.source_key, trajectoryExercise]
+              )
+            ).rows;
+            if (accountingRows.length > 1) {
+              let cumulative = 0;
+              actual = accountingRows.map((row: any) => {
+                cumulative += Number(row.movement || 0);
+                const date = row.month_date instanceof Date ? row.month_date.toISOString().slice(0, 10) : String(row.month_date).slice(0, 10);
+                const parsed = new Date(`${date}T12:00:00`);
+                return { date, month: parsed.getMonth() + 1, value: Math.abs(cumulative) };
+              });
+              actualSource = 'ACCOUNTING_LINES';
+            }
+          }
+
+          let previous = monthlyLatest(trajectoryExercise - 1);
+          if (previous.length < 2) {
+            const previousRows = (
+              await pool.query(
+                `select date_trunc('month',period_date)::date month_date,
+                        coalesce(sum(movement),0) movement
+                 from accounting_lines
+                 where upper(opale_entity)=upper($1)
+                   and extract(year from period_date)=$2
+                   and account ~ '^6'
+                   and coalesce(movement_kind,'') <> 'OPENING'
+                 group by date_trunc('month',period_date)
+                 order by month_date`,
+                [e.opaleEntity || e.sources.budget.source_key, trajectoryExercise - 1]
+              )
+            ).rows;
+            let cumulative = 0;
+            if (previousRows.length > 1) {
+              previous = previousRows.map((row: any) => {
+                cumulative += Number(row.movement || 0);
+                const date = row.month_date instanceof Date ? row.month_date.toISOString().slice(0, 10) : String(row.month_date).slice(0, 10);
+                const parsed = new Date(`${date}T12:00:00`);
+                return { date, month: parsed.getMonth() + 1, value: Math.abs(cumulative) };
+              });
+            }
+          }
+
+          const latestDep = depHistory.filter((row: any) => row.exercise === trajectoryExercise).at(-1)!;
+          const trajectoryTarget = Math.max(0.15, Math.min(0.98, budgetTrajectoryTarget(latestDep.date)));
+          const known = Math.max(latestDep.accounted, latestDep.committed);
+          const pace = latestDep.accounted / trajectoryTarget;
+          const central = Math.min(latestDep.budget || Number.POSITIVE_INFINITY, Math.max(known, pace));
+          const uncertainty = Math.max(0, central - latestDep.accounted) * 0.18;
+          const depForecast = {
+            low: Math.max(known, central - uncertainty),
+            central,
+            high: central + uncertainty
+          };
+          const budgetReference = Array.from({ length: 12 }, (_, index) => {
+            const month = index + 1;
+            const date = `${trajectoryExercise}-${String(month).padStart(2, '0')}-${String(new Date(trajectoryExercise, month, 0).getDate()).padStart(2, '0')}`;
+            return { date, month, value: latestDep.budget * budgetTrajectoryTarget(date) };
+          });
+
+          e.financialTrajectory = {
+            mode: 'DEP',
+            source: actualSource,
+            exercise: trajectoryExercise,
+            snapshotDate: latestDep.date,
+            actual,
+            previous: previous.length ? { [String(trajectoryExercise - 1)]: previous } : {},
+            budgetReference,
+            forecast: depForecast,
+            annualBudgetResult: latestDep.budget
+          };
         }
         states.budget = severity(e.signals.filter((x: any) => x.domain === 'Budget'));
